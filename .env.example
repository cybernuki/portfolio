# Public site URL used for canonical links, hreflang, sitemap and JSON-LD. Required on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Optional: raises the GitHub API rate limit at build time. Without it the build still works.
GITHUB_TOKEN=
# Optional: set to true to bring back the music and sound-effects controls (off by default).
NEXT_PUBLIC_ENABLE_AUDIO=
